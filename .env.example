# Leave DATABASE_URL unset to use the embedded PGlite database in ./.pglite (zero setup).
# DATABASE_URL=postgres://ai4brain:ai4brain@localhost:5432/ai4brain
# PGLITE_DIR=./.pglite

# AI coach. Set one provider key; without any (or with COACH_LLM=off) the rule-based coach answers instead.
# Claude is used when ANTHROPIC_API_KEY is set, otherwise Groq when GROQ_API_KEY is set.
# ANTHROPIC_API_KEY=
# COACH_MODEL=claude-opus-5-5
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# COACH_PROVIDER=groq   # force one provider: claude | groq
# COACH_LLM=off
